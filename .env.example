# Supabase credentials — copy this file to `.env` and fill in your values.
# These are read in exactly ONE place: src/lib/supabase.ts
# Leave them blank (or delete .env) to run in local demo/mock mode.
#
# VITE_SUPABASE_URL is the *API* URL: https://<project-ref>.supabase.co
# (find it in the dashboard under Project Settings → Data API — NOT the
# dashboard page URL itself).
# VITE_SUPABASE_ANON_KEY is the "anon / public" key from the same page.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
